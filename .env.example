# GEMINI_API_KEY: Required for live Gemini AI trip generation.
GEMINI_API_KEY=

# Optional AI configuration overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=25000
GEMINI_DEADLINE_MS=60000

# Optional second global autocomplete provider (server-only key)
GEOAPIFY_API_KEY=

# Application URL
APP_URL=
