# TREK - Travel Resource & Exploration Kit Configuration
PORT=3000
NODE_ENV=development
TZ=UTC
LOG_LEVEL=info
# Live AI trip generation. Without a key every plan is served as a clearly labelled sample.
GEMINI_API_KEY=
# Comma separated priority list; the first id the account cannot use falls through to the next.
GEMINI_MODEL=gemini-2.5-flash
# Per-attempt HTTP timeout and the total wall-clock budget before the sample plan is served.
GEMINI_TIMEOUT_MS=25000
GEMINI_DEADLINE_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=8192
# Testing only: point the Google SDK at a stand-in endpoint. Leave empty in production.
GEMINI_BASE_URL=
APP_URL=
DEMO_MODE=false
COOKIE_SECURE=false
TRUST_PROXY=1

# Optional second global autocomplete provider (server-only key)
GEOAPIFY_API_KEY=
